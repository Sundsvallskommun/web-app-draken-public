# Environment
NODE_ENV=development
ENVIRONMENT=LOCAL
PORT=3001
BASE_URL_PREFIX=/vof
API_BASE_URL=https://api-i-test.sundsvall.se
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# IAF/VOF investigations require the Support Management sprint subscription.
SUPPORTMANAGEMENT_API_TARGET=sprint

# SAML
SAML_CALLBACK_URL=http://localhost:3001/vof/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/vof/saml/logout/callback
SAML_SUCCESS_BASE=http://localhost:3039
SAML_FAILURE_REDIRECT=http://localhost:3001/vof/saml/login
SAML_FAILURE_REDIRECT_MESSAGE=http://localhost:3039/login
SAML_SUCCESS_REDIRECT=http://localhost:3039/vof
SAML_LOGOUT_REDIRECT=http://localhost:3039/
SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_LOGOUT_URL=http://{{domain-to-sso}}/logout
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_CERT}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

# Identity and application
AUTHORIZED_GROUPS="{{INSERT_AUTHORIZED_GROUP}}"
ADMIN_GROUP="{{INSERT_ADMIN_GROUP}}"
# Populates "Tilldela handläggare": comma-separated AD groups whose members can be selected as handlers.
# Duplicate AD accounts are shown once. Explicit groups replace ADMIN_GROUP for this list;
# include ADMIN_GROUP's group name in the list if its members should also be selectable.
# Fallback: if unset, empty or whitespace-only, use members of ADMIN_GROUP (which must then be set).
# Failed group lookups return an error; they do not trigger fallback to ADMIN_GROUP.
# This only populates the selector; it does not grant login, admin or investigation document permissions.
# TODO: Consolidate ADMIN_GROUP and ASSIGNABLE_HANDLER_GROUPS
# into explicit configuration for handler selection and application privileges.
# Investigation document rights are owned by Support Management access.
# ASSIGNABLE_HANDLER_GROUPS="{{INSERT_ENHETSCHEF_GROUP}},{{INSERT_SOL_LSS_GROUP}},{{INSERT_HSL_GROUP}},{{INSERT_INVESTIGATION_ADMIN_GROUP}}"
DEVELOPER_GROUP="{{INSERT_DEVELOPER_GROUP}}"
SUPERADMIN_GROUP="{{INSERT_SUPERADMIN_GROUP}}"
APPLICATION=VOF
# Optional. Leave empty to use the application's local feature configuration.
ADMINPANEL_URL=
MUNICIPALITY_ID=2281
DOMAIN=personal

# Encryption, diagnostics and CORS
SECRET_KEY={{INSERT SECRET KEY}}
SWAGGER_ENABLED=true
LOG_FORMAT=dev
LOG_DIR=../../data/logs
ORIGIN=http://localhost:3039
CREDENTIALS=true

# Support Management
SUPPORTMANAGEMENT_TEST_EMAIL=name@example.com
SUPPORTMANAGEMENT_SENDER_EMAIL=name@sundsvall.se
SUPPORTMANAGEMENT_SENDER_SMS=070-...
SUPPORTMANAGEMENT_NAMESPACE=HEALTHCAREDEVIATIONVOF

# Investigation access comes from Support Management Sprint /errands/{errandId}/access.
# Configure document keys and levels centrally in Support Management / AccessMapper.

# Åtgärder: VoF:s testgrupper -> namespace Role.name -> grupp i MeasureType.measureGroups.
# API-metadatan äger typerna; här anges endast AD-grupper, roller och typgrupp.
# För produktion används motsvarande AD-gruppnamn utan _Test.
# Beskrivning: frontend/src/supportmanagement/measures/README.md
SUPPORT_MEASURE_REGISTRATION='[{"roleName":"UNIT_MANAGER","decides":true,"adGroups":["SG_Appl_Draken_Enhetschef_Vof_Test","SG_Appl_Draken_Avvikelse_Admin_Test"],"measureGroup":"UNIT_MANAGER"},{"roleName":"MAR_MAS","adGroups":["SG_Appl_Draken_MAS_MAR_Vof_Test","SG_Appl_Draken_Avvikelse_Admin_Test"],"measureGroup":"HSL_MAS_MAR"},{"roleName":"LEX_INVESTIGATOR","adGroups":["SG_Appl_Draken_LEX_Utredare_Vof_Test","SG_Appl_Draken_Avvikelse_Admin_Test"],"measureGroup":"SOL_LSS"}]'
