# Environment
NODE_ENV=development
ENVIRONMENT=LOCAL
PORT=3001
BASE_URL_PREFIX=/iaf
API_BASE_URL=https://api-i-test.sundsvall.se
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# IAF/VOF investigations require the Support Management sprint subscription.
SUPPORTMANAGEMENT_API_TARGET=sprint

# SAML
SAML_CALLBACK_URL=http://localhost:3001/iaf/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/iaf/saml/logout/callback
SAML_SUCCESS_BASE=http://localhost:3000
SAML_FAILURE_REDIRECT=http://localhost:3001/iaf/saml/login
SAML_FAILURE_REDIRECT_MESSAGE=http://localhost:3000/login
SAML_SUCCESS_REDIRECT=http://localhost:3000/iaf
SAML_LOGOUT_REDIRECT=http://localhost:3000/
SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_LOGOUT_URL=http://{{domain-to-sso}}/logout
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_CERT}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

# Identity and application
AUTHORIZED_GROUPS="{{INSERT_AUTHORIZED_GROUP}}"
ADMIN_GROUP="{{INSERT_ADMIN_GROUP}}"
# Populates "Tilldela handläggare": comma-separated AD groups whose members can be selected as handlers.
# Duplicate AD accounts are shown once. Explicit groups replace ADMIN_GROUP for this list;
# include ADMIN_GROUP's group name in the list if its members should also be selectable.
# Fallback: if unset, empty or whitespace-only, use members of ADMIN_GROUP (which must then be set).
# Failed group lookups return an error; they do not trigger fallback to ADMIN_GROUP.
# This only populates the selector; it does not grant login, admin or investigation document permissions.
# TODO: Consolidate ADMIN_GROUP, ASSIGNABLE_HANDLER_GROUPS and SUPPORT_INVESTIGATION_DOCUMENT_GROUPS
# into one structured env variable with explicit roles for handler selection, admin privileges and
# document read/write access, so shared group definitions do not implicitly grant extra permissions.
# ASSIGNABLE_HANDLER_GROUPS="{{INSERT_ENHETSCHEF_GROUP}},{{INSERT_SOL_LSS_GROUP}},{{INSERT_HSL_GROUP}},{{INSERT_INVESTIGATION_ADMIN_GROUP}}"

# Handler roles: the richer spelling of ASSIGNABLE_HANDLER_GROUPS. It names the same AD groups and
# also says which role each group stands for, which is what the investigation assignment steps need
# ("hand this to a LEX-ansvarig", "give it back to the enhetschef"). When set it REPLACES
# ASSIGNABLE_HANDLER_GROUPS: the flat handler list is derived from it, so there is one list to keep
# current. Array order is the order the groups appear in the handler selector.
# The role keys enhetschef, lex-ansvarig and lex-utredare are referenced by the handover steps;
# renaming a key disables the step that needs it.
# Like ASSIGNABLE_HANDLER_GROUPS this only populates the selector and guards assignment - it grants
# no login, admin or investigation document permission.
# HANDLER_GROUP_ROLES='[{"key":"enhetschef","label":"Enhetschef","group":"{{INSERT_ENHETSCHEF_GROUP}}"},{"key":"lex-ansvarig","label":"LEX-ansvarig","group":"{{INSERT_LEX_ANSVARIG_GROUP}}"},{"key":"lex-utredare","label":"LEX-utredare","group":"{{INSERT_LEX_UTREDARE_GROUP}}"},{"key":"mas-mar","label":"MAS/MAR","group":"{{INSERT_HSL_GROUP}}"}]'
DEVELOPER_GROUP="{{INSERT_DEVELOPER_GROUP}}"
SUPERADMIN_GROUP="{{INSERT_SUPERADMIN_GROUP}}"
APPLICATION=IAF
ADMINPANEL_URL={{INSERT_ADMINPANEL_URL}}
MUNICIPALITY_ID=2281
DOMAIN=personal

# Encryption, diagnostics and CORS
SECRET_KEY={{INSERT SECRET KEY}}
SWAGGER_ENABLED=true
LOG_FORMAT=dev
LOG_DIR=../../data/logs
ORIGIN=http://localhost:3000
CREDENTIALS=true

# Support Management
SUPPORTMANAGEMENT_TEST_EMAIL=name@example.com
SUPPORTMANAGEMENT_SENDER_EMAIL=name@sundsvall.se
SUPPORTMANAGEMENT_SENDER_SMS=070-...
SUPPORTMANAGEMENT_NAMESPACE=HEALTHCAREDEVIATIONIAF

# Investigation
# Optional. editorGroups grants read/write; readerGroups grants read-only access.
# Unset means every configured investigation document stays visible and editable for all handlers.
# SUPPORT_INVESTIGATION_DOCUMENT_GROUPS='[{"documentKey":"utredning-enhetschef","editorGroups":["{{INSERT_ENHETSCHEF_GROUP}}","{{INSERT_INVESTIGATION_ADMIN_GROUP}}"],"readerGroups":["{{INSERT_HSL_GROUP}}","{{INSERT_SOL_LSS_GROUP}}"]},{"documentKey":"utredning-sol-lss","editorGroups":["{{INSERT_SOL_LSS_GROUP}}","{{INSERT_INVESTIGATION_ADMIN_GROUP}}"],"readerGroups":["{{INSERT_HSL_GROUP}}"]},{"documentKey":"utredning-hsl","editorGroups":["{{INSERT_HSL_GROUP}}","{{INSERT_INVESTIGATION_ADMIN_GROUP}}"],"readerGroups":["{{INSERT_SOL_LSS_GROUP}}"]}]'
