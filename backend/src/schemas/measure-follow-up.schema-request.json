{
  "name": "measure-follow-up",
  "version": "2.0",
  "description": "Uppföljningar av ärendets planerade och godkända åtgärder, en post per åtgärd med åtgärdens id i posten. Dokumentet har en stabil nyckel så att behörighet kan ges på nyckelnivå. Svaren sparas före genomförandet så att avbrutet sparande kan slutföras, och en sparad post ändras aldrig.",
  "value": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Uppföljning av åtgärder",
    "type": "object",
    "additionalProperties": false,
    "required": ["followUps"],
    "properties": {
      "followUps": {
        "type": "array",
        "title": "Uppföljningar",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measureId", "measureVersion", "executed", "desiredEffectAchieved", "followUpDescription", "recordedBy", "recordedAt"],
          "properties": {
            "measureId": {
              "type": "string",
              "minLength": 1
            },
            "measureVersion": {
              "type": "integer",
              "minimum": 0
            },
            "executed": {
              "type": "string",
              "format": "date-time"
            },
            "desiredEffectAchieved": {
              "type": "boolean",
              "title": "Har åtgärd lett till önskad effekt?"
            },
            "followUpDescription": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 4000,
              "title": "Vad har hänt?"
            },
            "recordedBy": {
              "type": "string",
              "pattern": "\\S"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
