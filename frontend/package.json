{
  "name": "draken-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:dev:kc": "dotenv -e .env.kc",
    "env:dev:mex": "dotenv -e .env.mex",
    "env:dev:pt": "dotenv -e .env.pt",
    "dev:bou": "dotenv -e .env.bou -- next dev",
    "dev:lok": "dotenv -e .env.lok -- next dev",
    "dev:ik": "dotenv -e .env.ik -- next dev",
    "dev:kc": "dotenv -e .env.kc -- next dev",
    "dev:ka": "dotenv -e .env.ka -- next dev",
    "dev:lop": "dotenv -e .env.lop -- next dev",
    "dev:mex": "dotenv -e .env.mex -- next dev",
    "dev:pt": "dotenv -e .env.pt -- next dev",
    "dev:msva": "dotenv -e .env.msva -- next dev",
    "dev:rob": "dotenv -e .env.rob -- next dev",
    "dev:iaf": "dotenv -e .env.iaf -- next dev",
    "dev:se": "dotenv -e .env.se -- next dev",
    "build:bou": "node ../scripts/generate-deploy-info.js && dotenv -e .env.bou -- next build",
    "build:lok": "node ../scripts/generate-deploy-info.js && dotenv -e .env.lok -- next build",
    "build:ik": "node ../scripts/generate-deploy-info.js && dotenv -e .env.ik -- next build",
    "build:kc": "node ../scripts/generate-deploy-info.js && dotenv -e .env.kc -- next build",
    "build:ka": "node ../scripts/generate-deploy-info.js && dotenv -e .env.ka -- next build",
    "build:lop": "node ../scripts/generate-deploy-info.js && dotenv -e .env.lop -- next build",
    "build:mex": "node ../scripts/generate-deploy-info.js && dotenv -e .env.mex -- next build",
    "build:pt": "node ../scripts/generate-deploy-info.js && dotenv -e .env.pt -- next build",
    "build:msva": "node ../scripts/generate-deploy-info.js && dotenv -e .env.msva -- next build",
    "build:rob": "node ../scripts/generate-deploy-info.js && dotenv -e .env.rob -- next build",
    "build:iaf": "node ../scripts/generate-deploy-info.js && dotenv -e .env.iaf -- next build",
    "build:se": "node ../scripts/generate-deploy-info.js && dotenv -e .env.se -- next build",
    "build": "dotenv -e .env.local -- next build",
    "start:bou": "dotenv -e .env.bou -- dotenv next start",
    "start:lok": "dotenv -e .env.lok -- dotenv next start",
    "start:ik": "dotenv -e .env.ik -- dotenv next start",
    "start:kc": "dotenv -e .env.kc -- dotenv next start",
    "start:ka": "dotenv -e .env.ka -- dotenv next start",
    "start:lop": "dotenv -e .env.lop -- dotenv next start",
    "start:mex": "dotenv -e .env.mex -- dotenv next start",
    "start:pt": "dotenv -e .env.pt -- dotenv next start",
    "start:msva": "dotenv -e .env.msva -- dotenv next start",
    "start:rob": "dotenv -e .env.rob -- dotenv next start",
    "start:iaf": "dotenv -e .env.iaf -- dotenv next start",
    "start:se": "dotenv -e .env.se -- dotenv next start",
    "generate:contracts:lop": "dotenv -e .env.lop npx tsx ./src/swagger-typescript-api.ts",
    "generate:contracts:kc": "dotenv -e .env.kc npx tsx ./src/swagger-typescript-api.ts",
    "generate:contracts:ka": "dotenv -e .env.ka npx tsx ./src/swagger-typescript-api.ts",
    "generate:contracts:mex": "dotenv -e .env.mex npx tsx ./src/swagger-typescript-api.ts",
    "generate:contracts:pt": "dotenv -e .env.pt npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "lint:strict": "eslint src/ e2e/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --pretty --noEmit",
    "knip": "dotenv -e .env-cicd -- knip",
    "knip:production": "dotenv -e .env-cicd -- knip --production",
    "test:e2e": "playwright test",
    "test:e2e:mex": "dotenv -e .env.mex -- playwright test --project=mex",
    "test:e2e:pt": "dotenv -e .env.pt -- playwright test --project=pt",
    "test:e2e:kc": "dotenv -e .env.kc -- playwright test --project=kc",
    "test:e2e:lop": "dotenv -e .env.lop -- playwright test --project=lop",
    "test:e2e:ui:mex": "dotenv -e .env.mex -- playwright test --project=mex --ui",
    "test:e2e:ui:pt": "dotenv -e .env.pt -- playwright test --project=pt --ui",
    "test:e2e:ui:kc": "dotenv -e .env.kc -- playwright test --project=kc --ui",
    "test:e2e:ui:lop": "dotenv -e .env.lop -- playwright test --project=lop --ui",
    "test:e2e:report": "playwright show-report",
    "test": "vitest run",
    "test:json": "vitest run src/common/components/json",
    "type-check:test": "tsc -p tsconfig.test.json --pretty --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@sk-web-gui/button": "2.1.11",
    "@sk-web-gui/core": "4.6.2",
    "@sk-web-gui/react": "3.1.3",
    "@sk-web-gui/table": "3.2.21",
    "@sk-web-gui/text-editor": "2.1.0",
    "ajv": "^8.20.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "envalid": "^8.2.0",
    "escape-string-regexp": "^5.0.0",
    "i18next": "^26.7.2",
    "i18next-resources-to-backend": "^1.2.4",
    "lucide-react": "0.575.0",
    "next": "16.2.12",
    "next-i18n-router": "^5.5.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^15.6.1",
    "react-image-crop": "^10.0.7",
    "sanitize-html": "^2.18.1",
    "sass": "^1.108.1",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.3",
    "yup": "1.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.2",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^26.1.0",
    "knip": "^6.44.2",
    "postcss": "^8.5.32",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "prettier": "^2.4.1",
    "swagger-typescript-api": "13.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "eslint-plugin-react-hooks": "7.0.1",
    "form-data": "^4.0.6",
    "postcss": "^8.5.32",
    "react-hook-form": "^7.91.0"
  }
}
