PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/kc
DOMAIN_NAME=localhost
NEXT_PUBLIC_APPLICATION=KC
NEXT_PUBLIC_APPLICATION_NAME="Kontakt Sundsvall"
NEXT_PUBLIC_BASEPATH=/kc
NEXT_PUBLIC_ENVIRONMENT=TEST
HEALTH_AUTH=false
HEALTH_USERNAME=''
HEALTH_PASSWORD=''
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_MUNICIPALITY_ID=2281
NEXT_PUBLIC_REOPEN_SUPPORT_ERRAND_LIMIT=60
NEXT_PUBLIC_SHOW_DEPLOY_INFO=false

#Global flags (Documentation: https://confluence.sundsvall.se/spaces/OA/pages/1259405457/Feature+flaggor+alla+drakar)
NEXT_PUBLIC_IS_SUPPORTMANAGEMENT=true
NEXT_PUBLIC_USE_LABEL_CATEGORIZATION=true
NEXT_PUBLIC_USE_EXPLANATION_OF_THE_CAUSE=true
NEXT_PUBLIC_USE_REASON_FOR_CONTACT=true
NEXT_PUBLIC_USE_BUSINESS_CASE=true
NEXT_PUBLIC_USE_FACILITIES=true
NEXT_PUBLIC_USE_DEPARTMENT_ESCALATION=true
NEXT_PUBLIC_USE_ORGANIZATION_STAKEHOLDER=true
NEXT_PUBLIC_USE_EMAIL_CONTACT_CHANNEL=true
NEXT_PUBLIC_USE_SMS_CONTACT_CHANNEL=true
NEXT_PUBLIC_USE_STAKEHOLDER_RELATIONS=true
NEXT_PUBLIC_USE_ROLES_FOR_STAKEHOLDERS=true
NEXT_PUBLIC_USE_ESCALATION=true
NEXT_PUBLIC_USE_HANDOVER=true
NEXT_PUBLIC_USE_MY_PAGES=true
NEXT_PUBLIC_USE_SERVICES=true

#Telia ACE Agent Interface (screen pop). Leave empty to disable.
#ACE_ORIGIN = origin of ACE Interact, e.g. https://<ace-host>. ACE_COMPANY = company name in ACE.
NEXT_PUBLIC_ACE_ORIGIN=
NEXT_PUBLIC_ACE_COMPANY=
#Development only: fake ACE JS API, trigger a call with drakenAceMock.screenPop() in the browser console
NEXT_PUBLIC_ACE_MOCK=false

#Temporary
NEXT_PUBLIC_USE_RELATIONS=true
NEXT_PUBLIC_PROTECTED_ROUTES=/oversikt,/registrera,/arende
NEXT_PUBLIC_APP_URL=http://localhost:3000