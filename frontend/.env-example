PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/{{kc|mex}}
NEXT_PUBLIC_APPLICATION={{KC|MEX}}
NEXT_PUBLIC_BASEPATH={{/kc|/mex}}
NEXT_PUBLIC_ENVIRONMENT=TEST
HEALTH_AUTH=false
HEALTH_USERNAME=''
HEALTH_PASSWORD=''
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_PROTECTED_ROUTES=/oversikt,/registrera,/arende

# OIDC (POC, additive) - true switches login/logout to the backend /oidc endpoints.
# Must match the backend OIDC_ENABLED flag. Unset/false = SAML login as before.
NEXT_PUBLIC_OIDC_ENABLED=false
