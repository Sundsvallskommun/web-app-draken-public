{
  // The root tsconfig's `include` does not match the colocated `*.test.ts` files, so they
  // would otherwise go unchecked. This config type-checks them (and, transitively, the
  // modules they exercise). Run it with `yarn type-check:test`; the backend has the same
  // split for the same reason.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "vitest.config.mts", "next-env.d.ts"]
}
