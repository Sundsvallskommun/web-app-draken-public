{
  "name": "beslut-missforhallande",
  "version": "1.0",
  "value": {
    "$id": "https://schemas.sundsvall.se/2281/beslut-missforhallande/1.0",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Beslut missförhållande",
    "description": "Beslut enligt lex Sarah för IAF- och VOF-ärenden med rapporttyp missförhållande. Utredarens förslag till beslut ligger i SOL/LSS-utredningen och kopieras inte hit.",
    "type": "object",
    "additionalProperties": false,
    "required": ["decisionDate", "misconductEstablished", "reportedToIvo"],
    "properties": {
      "decisionDate": {
        "title": "Beslutsdatum",
        "type": "string",
        "format": "date"
      },
      "misconductEstablished": {
        "title": "Utredningen visar att ett missförhållande eller påtaglig risk för missförhållande föreligger",
        "$ref": "#/$defs/yesNo"
      },
      "misconductEstablishedMotivation": {
        "title": "Motivering",
        "description": "Obligatorisk när svaret är Nej.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "seriousMisconduct": {
        "title": "Var det ett allvarligt missförhållande?",
        "$ref": "#/$defs/yesNo"
      },
      "seriousMisconductMotivation": {
        "title": "Motivering",
        "description": "Obligatorisk när svaret är Nej.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "tangibleRiskOfSeriousMisconduct": {
        "title": "Var det påtaglig risk för ett allvarligt missförhållande?",
        "$ref": "#/$defs/yesNo"
      },
      "tangibleRiskOfSeriousMisconductMotivation": {
        "title": "Motivering",
        "description": "Obligatorisk när svaret är Nej.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "reportedToIvo": {
        "title": "Lämnas anmälan enligt lex Sarah över till IVO?",
        "$ref": "#/$defs/yesNo"
      },
      "reportedToIvoMotivation": {
        "title": "Motivering",
        "description": "Obligatorisk när svaret är Nej.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "ivoCaseNumber": {
        "title": "IVO ärendenummer",
        "description": "Anges när anmälan har lämnats till IVO.",
        "type": "string",
        "minLength": 1
      },
      "supplementaryInformation": {
        "title": "Kompletterande information",
        "type": "string",
        "contentMediaType": "text/html"
      }
    },
    "$defs": {
      "yesNo": {
        "type": "string",
        "oneOf": [
          { "const": "yes", "title": "Ja" },
          { "const": "no", "title": "Nej" }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "misconductEstablished": { "const": "yes" } },
          "required": ["misconductEstablished"]
        },
        "then": {
          "required": ["seriousMisconduct", "tangibleRiskOfSeriousMisconduct"]
        },
        "else": {
          "required": ["misconductEstablishedMotivation"],
          "properties": {
            "misconductEstablishedMotivation": { "minLength": 1 }
          },
          "not": {
            "anyOf": [
              { "required": ["seriousMisconduct"] },
              { "required": ["seriousMisconductMotivation"] },
              { "required": ["tangibleRiskOfSeriousMisconduct"] },
              { "required": ["tangibleRiskOfSeriousMisconductMotivation"] }
            ]
          }
        }
      },
      {
        "if": {
          "properties": { "seriousMisconduct": { "const": "no" } },
          "required": ["seriousMisconduct"]
        },
        "then": {
          "required": ["seriousMisconductMotivation"],
          "properties": {
            "seriousMisconductMotivation": { "minLength": 1 }
          }
        }
      },
      {
        "if": {
          "properties": { "tangibleRiskOfSeriousMisconduct": { "const": "no" } },
          "required": ["tangibleRiskOfSeriousMisconduct"]
        },
        "then": {
          "required": ["tangibleRiskOfSeriousMisconductMotivation"],
          "properties": {
            "tangibleRiskOfSeriousMisconductMotivation": { "minLength": 1 }
          }
        }
      },
      {
        "if": {
          "properties": { "reportedToIvo": { "const": "yes" } },
          "required": ["reportedToIvo"]
        },
        "then": {
          "not": { "required": ["reportedToIvoMotivation"] }
        },
        "else": {
          "required": ["reportedToIvoMotivation"],
          "properties": {
            "reportedToIvoMotivation": { "minLength": 1 }
          },
          "not": { "required": ["ivoCaseNumber"] }
        }
      }
    ]
  },
  "description": "WSO2 request body for version 1.0 of the reported misconduct decision schema"
}
