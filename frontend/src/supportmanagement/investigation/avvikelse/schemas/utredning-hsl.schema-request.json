{
  "name": "utredning-hsl",
  "version": "1.1",
  "value": {
    "$id": "https://schemas.sundsvall.se/2281/utredning-hsl/1.1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Utredning HSL",
    "description": "HSL-utredning för IAF- och VOF-ärenden. Beslutet om anmälan till IVO, åtgärder och handlingsplan lagras inte i detta dokument.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assignment": {
        "title": "Uppdrag",
        "description": "Beskriv syftet med analysen, uppdragsgivaren, uppdragsdatum och startdatum.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "analysisTeamParticipants": {
        "title": "Deltagare i analysteam",
        "description": "Personer som deltagit i analysteamet eller medverkat på annat sätt.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": {
              "title": "Roll",
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "title": "Enhet",
              "type": "string"
            }
          }
        }
      },
      "methodology": {
        "title": "Beskrivning av metodik",
        "description": "Beskriv analysmetod, källor och avgränsningar.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "eventDescription": {
        "title": "Händelsebeskrivning",
        "description": "Presentera händelsen och händelseförloppet på ett sätt som kan förstås utan medicinsk specialkunskap.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "identifiedCauses": {
        "title": "Vilka orsaker till händelsen har identifierats?",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "oneOf": [
            { "const": "communication_information", "title": "Kommunikation och information" },
            { "const": "education_competence", "title": "Utbildning och kompetens" },
            { "const": "processes_routines_guidelines", "title": "Processer, rutiner och riktlinjer" },
            { "const": "environment_organization", "title": "Omgivning och organisation" },
            { "const": "technology_equipment", "title": "Teknik, utrustning och apparatur" }
          ]
        }
      },
      "underlyingCauses": {
        "title": "Bakomliggande orsak",
        "description": "Flerval enligt utredningsskissen.",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "oneOf": [
            { "const": "communication_failure", "title": "Brist i kommunikation" },
            { "const": "time_pressure_workload", "title": "Tidsbrist / arbetsbelastning" },
            { "const": "knowledge_gap", "title": "Kunskapsbrist" },
            { "const": "routine_missing_not_followed", "title": "Rutin saknas eller följs inte" },
            { "const": "technical_fault", "title": "Tekniskt fel" },
            { "const": "other", "title": "Övrigt" }
          ]
        }
      },
      "contributingFactorsAndRisks": {
        "title": "Bidragande faktorer och andra upptäckta risker",
        "description": "Beskriv bakomliggande orsaker, bifynd, andra upptäckta risker samt vårdskade- eller kvalitetsbristkostnader.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "analysisEvaluation": {
        "title": "Analysutvärdering",
        "description": "Bedöm robusthet, relevans, resursbehov, resultatmått och om föreslagna insatser riktar sig mot bakomliggande orsaker.",
        "type": "string",
        "contentMediaType": "text/html"
      },
      "commissionerComment": {
        "title": "Uppdragsgivarens kommentar",
        "description": "Uppdragsgivarens kommentar på händelseanalysen.",
        "type": "string",
        "contentMediaType": "text/html"
      }
    }
  },
  "description": "WSO2 request body for version 1.1 of the HSL investigation schema"
}
