{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "exclude": [
    "enumMembers"
  ],
  "ignore": [
    "src/data-contracts/**",
    "src/common/data-contracts/**"
  ],
  "ignoreDependencies": [
    "swagger-typescript-api"
  ],
  "ignoreBinaries": [
    "tsx"
  ]
}
